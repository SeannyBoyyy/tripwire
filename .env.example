# Optional, and only if you run the app without the Worker: a free CoinGecko Demo key for steadier rate
# limits. It ships inside the app. With the Worker, leave it empty and give the key to the Worker instead
# (npx wrangler secret put COINGECKO_KEY).
# Copy this file to .env, then restart with: npx expo start -c
EXPO_PUBLIC_COINGECKO_KEY=

# Alerts while the app is fully closed (see README, "Alerts while the app is fully closed").
# The URL your Worker prints on deploy, and the same API_KEY you set on it.
# This key ships inside the app bundle (and any update you publish). Treat it as public; it only deters
# casual use of your Worker.
EXPO_PUBLIC_TRIPWIRE_API=
EXPO_PUBLIC_TRIPWIRE_KEY=
